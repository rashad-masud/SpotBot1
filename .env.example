PAPER_TRADE=true
STARTING_CAPITAL=1000
TIMEFRAME=5m
# Set a pair to bypass the multi-pair scanner, e.g. ZEC/USDT
TRADING_SYMBOL=ZEC/USDT
# ZEC-oriented starting parameters; validate with backtesting before live use.
MIN_STOP_PCT=0.015
MAX_STOP_PCT=0.07
VOL_STOP_MULTIPLIER=2.5
TRAIL_TRIGGER_PNL=0.04
TRAIL_DISTANCE_PCT=0.018
TAKE_PROFIT_PCT=0.08
REGIME_LOOKBACK_CANDLES=72
MIN_TREND_PCT=0.02
TREND_STRENGTH_MIN=2.0
MAX_VOLATILITY_TO_AVOID=0.055
EXTREME_VOLATILITY_THRESHOLD=0.035
MIN_TREND_AGE_TO_TRADE=3
RISK_PER_TRADE_PCT=0.01
MAX_TOTAL_EXPOSURE_PCT=0.30
TAKER_FEE_PCT=0.001
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
ENABLE_EMAIL=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_RECIPIENT=

# Historical context before first live entry
HISTORICAL_CANDLE_ANALYSIS=24h
HISTORICAL_CANDLE_TIMEFRAME=5m
ALLOW_ENTRY_ON_FIRST_LIVE_CANDLE=false

# Strategy diagnostics
DIAGNOSTIC_LOGGING=true
